# ZORAN V2 — variables d'environnement (VALEURS FICTIVES uniquement)
# Copier en .env localement/Codespace et renseigner ses vraies valeurs (jamais commitées).
ZORAN_ENV=sandbox
ZORAN_API_KEY=your-anthropic-key-here
ZORAN_OPENAI_KEY=your-openai-key-here
ZORAN_V2_NEUTRAL_ROUTE=0
# Ports sandbox (décalés vs prod 5175/8003/8910)
ZORAN_FRONTEND_PORT=5275
ZORAN_BACKEND_PORT=8103
ZORAN_ZMOS_PORT=8911
